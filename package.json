{
  "name": "ai-monster-courtroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Monster Courtroom \u2014 puts ideas on trial before a panel of adversarial AI monsters. Kiroween 2026 (Frankenstein).",
  "author": "Richard Chua",
  "license": "MIT",
  "repository": "https://github.com/RichardChua1234/ai-monster-courtroom",
  "scripts": {
    "dev": "devvit dev",
    "build": "tsc --noEmit && vite build",
    "deploy": "devvit deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "proveit": "python3 -m proveit check --spec .kiro/specs/ai-monster-courtroom --tests tests",
    "evidence": "python3 -m unittest discover -s tests -v",
    "prove": "PYTHONPATH=${PROVE_IT_SRC:-../prove-it/src} python3 -m proveit check --spec .kiro/specs/ai-monster-courtroom --tests tests",
    "verify": "npm run typecheck && npm run test && npm run prove"
  },
  "dependencies": {
    "@devvit/client": "^0.12.0",
    "@devvit/server": "^0.12.0",
    "hono": "^4.13.18",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
